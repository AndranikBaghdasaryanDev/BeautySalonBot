# Copy this file to .env and fill in real values. Never commit .env.

# --- Telegram -----------------------------------------------------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token

# "polling" (default, no public URL needed) or "webhook"
BOT_MODE=polling

# Webhook mode only. URL must be https; secret: 16-256 chars of A-Z a-z 0-9 _ -
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_URL=https://your-domain.example/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
PORT=8080
HOST=0.0.0.0

# --- MongoDB Atlas ------------------------------------------------------------
# Atlas -> Database -> Connect -> Drivers. Use a database user with readWrite on
# the database below (dbAdmin additionally lets the bot refresh the validator).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=beauty_salon

# --- Salon details (placeholders: replace with your real information) ---------
BEAUTY_SALON_NAME=[Salon name]
BEAUTY_SALON_ADDRESS=[Street, city]
BEAUTY_SALON_CONTACT=[Phone or @telegram_username of the salon]
BEAUTY_SALON_WORKING_HOURS=[Mon-Sat 10:00-20:00]
# Entries separated by ";", each "name|price|duration" (duration optional)
BEAUTY_SALON_SERVICES=[Service 1]|[price]|[duration];[Service 2]|[price]|[duration]

# --- Optional -----------------------------------------------------------------
# How often to re-check a customer's profile photo on /start
PROFILE_PHOTO_REFRESH_HOURS=24
# debug | info | warn | error
LOG_LEVEL=info
